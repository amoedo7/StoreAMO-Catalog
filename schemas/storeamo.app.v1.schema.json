{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desarrollamo.com.ar/schemas/storeamo.app.v1.schema.json",
  "title": "StoreAMO App Manifest v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "tagline",
    "description",
    "category",
    "status",
    "supported_platforms"
  ],
  "properties": {
    "schema": {
      "const": "storeamo.app.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "audience": {
      "enum": [
        "public",
        "team",
        "system"
      ],
      "default": "public"
    },
    "status": {
      "enum": [
        "development",
        "candidate",
        "verified",
        "deprecated"
      ]
    },
    "supported_platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "android",
          "windows",
          "macos",
          "linux",
          "web",
          "ios",
          "other"
        ]
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "visibility": {
          "enum": [
            "public",
            "private"
          ],
          "default": "public"
        },
        "repository": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        }
      },
      "additionalProperties": true
    },
    "distribution": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "mode": {
          "enum": [
            "github-release",
            "direct-artifacts",
            "external"
          ]
        }
      },
      "additionalProperties": true
    },
    "store": {
      "type": "object",
      "properties": {
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "privacy_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "homepage": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "release": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "github"
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "channel": {
          "enum": [
            "stable",
            "beta"
          ]
        },
        "tag_pattern": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "version_code": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "platform",
              "pattern"
            ],
            "properties": {
              "platform": {
                "enum": [
                  "android",
                  "windows",
                  "macos",
                  "linux",
                  "web",
                  "ios",
                  "other"
                ]
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "arch": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "format": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "application_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "min_os": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "signing_cert_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-Fa-f0-9]{64}$"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "platform",
          "url",
          "sha256",
          "version",
          "version_code"
        ],
        "properties": {
          "platform": {
            "enum": [
              "android",
              "windows",
              "macos",
              "linux",
              "web",
              "ios",
              "other"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "version_code": {
            "type": [
              "string",
              "integer"
            ]
          },
          "arch": {
            "type": [
              "string",
              "null"
            ]
          },
          "format": {
            "type": [
              "string",
              "null"
            ]
          },
          "application_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "min_os": {
            "type": [
              "string",
              "null"
            ]
          },
          "signing_cert_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "size_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "verification_report": {
            "type": [
              "string",
              "null"
            ]
          },
          "release_url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string"
        },
        "required_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
