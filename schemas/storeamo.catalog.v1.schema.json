{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desarrollamo.com.ar/schemas/storeamo.catalog.v1.schema.json",
  "title": "StoreAMO Catalog v1",
  "type": "object",
  "required": ["schema", "catalog_version", "brand", "apps"],
  "properties": {
    "schema": {"const": "storeamo.catalog.v1"},
    "catalog_version": {"type": "integer", "minimum": 1},
    "brand": {
      "type": "object",
      "required": ["name", "store_name", "accent", "accent_secondary", "background"],
      "additionalProperties": true
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "tagline", "description", "category", "featured", "status", "artifacts"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1},
          "tagline": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "featured": {"type": "boolean"},
          "status": {"enum": ["development", "candidate", "verified", "deprecated"]},
          "repository": {"type": ["string", "null"]},
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["platform", "version", "version_code", "url", "sha256", "verified"],
              "properties": {
                "platform": {"enum": ["android", "windows", "macos", "linux", "web", "ios", "other"]},
                "arch": {"type": ["string", "null"]},
                "format": {"type": ["string", "null"]},
                "version": {"type": "string", "minLength": 1},
                "version_code": {"type": ["integer", "string"]},
                "url": {"type": "string", "pattern": "^https://"},
                "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
                "size_bytes": {"type": ["integer", "null"], "minimum": 0},
                "min_os": {"type": ["string", "null"]},
                "verified": {"type": "boolean"},
                "verification_report": {"type": ["string", "null"]}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
